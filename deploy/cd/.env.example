# Script settings only; export these in the native Periphery execution environment.
# On an existing host, set the directory that contains the live Compose and .env.
HOMEDASHBOARD_ROOT=/opt/homedashboard
HOMEDASHBOARD_BACKEND_HEALTH_URL=http://127.0.0.1:8081/actuator/health
HOMEDASHBOARD_FRONTEND_HEALTH_URL=http://127.0.0.1:8080/
